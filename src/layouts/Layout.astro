---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'Annaska Andrizky | Full Stack Developer',
  active = 'home',
  extraHead = '',
  extraScripts = ''
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/img/favicon-nas.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script is:inline>
    (function () {
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <link href="/dist/output.css" rel="stylesheet">
  <style is:inline>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, h4, h5, h6, .font-outfit { font-family: 'Outfit', sans-serif; }
    #home > div > div > div:first-child { animation: renderFadeLeft 0.8s ease-out both; }
    #home article { animation: renderFadeRight 0.8s ease-out 120ms both; }
    .scroll-reveal-ready { opacity: 0 !important; transform: translateY(42px) !important; transition: opacity 850ms ease, transform 850ms ease; }
    .scroll-reveal-visible { opacity: 1 !important; transform: translateY(0) !important; }
    @keyframes renderFadeUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes renderFadeLeft { from { opacity: 0; transform: translateX(-28px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes renderFadeRight { from { opacity: 0; transform: translateX(28px); } to { opacity: 1; transform: translateX(0); } }
    @media (prefers-reduced-motion: reduce) {
      main > section, #home > div > div > div:first-child, #home article, #project article, #skills .grid > div, .scroll-reveal-ready {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>
  <Fragment set:html={extraHead} />
</head>

<body class="bg-white text-text-dark antialiased overflow-x-hidden transition-colors duration-300 dark:bg-gray-950 dark:text-gray-100">
  <Header active={active} />
  <slot />
  <Footer />
  <script is:inline src="/js/script.js"></script>
  <script is:inline>
    (function () {
      function initScrollReveal() {
        // Jangan sembunyikan apa pun jika user meminta reduced motion,
        // atau browser tidak mendukung IntersectionObserver.
        if (!('IntersectionObserver' in window) ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        // #home dikeluarkan: hero sudah punya animasi load renderFadeLeft/Right.
        var raw = document.querySelectorAll(
          'main > section:not(#home), #project article, #skills .grid > div'
        );
        if (!raw.length) return;

        // Buang target yang merupakan ancestor dari target lain.
        // Contoh: section#project gugur karena di dalamnya ada #project article,
        // section#skills gugur karena di dalamnya ada #skills .grid > div.
        // Section tanpa target di dalamnya (mis. #story, #contact, section di
        // halaman profile) tetap menjadi target sebagai satu blok.
        var items = Array.prototype.filter.call(raw, function (item) {
          return !Array.prototype.some.call(raw, function (other) {
            return other !== item && item.contains(other);
          });
        });
        if (!items.length) return;

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('scroll-reveal-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });

        items.forEach(function (item) {
          item.classList.add('scroll-reveal-ready');
        });

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            items.forEach(function (item) {
              observer.observe(item);
            });
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    })();
  </script>
  <Fragment set:html={extraScripts} />
</body>
</html>
